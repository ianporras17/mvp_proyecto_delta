# URL pública usada por la CLI que se ejecuta en el host.
COORDINATOR_URL=http://localhost:8000

# URLs públicas de los tres Node Agents que el Coordinator devuelve a la CLI.
PARTY_URLS=http://localhost:8100,http://localhost:8101,http://localhost:8102

# Control del Node Agent (Compose asigna un PARTY_ID distinto por servicio).
COORDINATOR_INTERNAL_URL=http://coordinator-api:8000
PARTY_ID=0
MPC_RUNTIME_ENABLED=1
MPSPDZ_ROOT=/opt/MP-SPDZ
MPC_HOSTS_FILE=/app/mpc/hosts-docker
MPC_PROGRAM=delta_video_identity

# Caja máxima de resolución compartida por cliente, Coordinator y parties.
MPC_MAX_WIDTH=640
MPC_MAX_HEIGHT=480
# El cliente muestrea hasta 10 FPS; --mpc-fps 5 conserva una opción más económica.

# ExternalIO desde la CLI en el host.
MPC_PARTY_HOSTS=localhost,localhost,localhost
MPC_CLIENT_PORT_BASE=14000
MPC_CLIENT_ID=0
MPC_CERT_DIR=.runtime/Player-Data
DELTA_OUTPUT_DIR=output
